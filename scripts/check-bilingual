#!/usr/bin/env ruby
# Checks the bilingual /pl/ pages generated by _plugins/bilingual-pl-pages.rb in a built site:
#   1. every page with a language switch has the hreflang trio (en, pl, x-default), en and x-default on its own URL,
#      pl on "pl/" + its own path, and the twin page exists and carries a language switch too (pairs point at each other)
#   2. every /pl/ page has <html lang="pl"> and a canonical pointing at itself
#   3. no page without a language switch carries a hreflang link (no non-bilingual post gets a /pl/ page)
#   4. the /pl/ pages are in sitemap.xml and absent from feed.xml (the feed stays English-only)
# usage: ./scripts/check-bilingual <site-dir> [baseurl]    e.g. ./scripts/check-bilingual _site
#        pass the baseurl for a preview build, e.g. ./scripts/check-bilingual _preview /preview/pr-9
#
# What it ignores: the Polish text itself (structure only), the #english/#polski anchors (html-proofer checks
# internal anchors), the feed item contents beyond /pl/ URLs, and where in <head> the links sit.

require 'bundler/setup'
require 'nokogiri'

dir, baseurl = ARGV
baseurl ||= ''
abort "usage: #{$PROGRAM_NAME} <site-dir> [baseurl]" if dir.nil? || !baseurl.empty? && !baseurl.start_with?('/')

def strip_origin(url, baseurl)
  path = url.to_s.sub(%r{\Ahttps?://[^/]+}, '')
  path = path.delete_prefix(baseurl) unless baseurl.empty?
  path
end

def switched?(file)
  Nokogiri::HTML(File.read(file)).at_css('.post-language-switch') ? true : false
end

problems = []
twin_switch_cache = {}

Dir.glob("#{dir}/**/*.html").sort.each do |file|
  page = file.delete_prefix("#{dir}/")
  doc = Nokogiri::HTML(File.read(file))
  lang_map = doc.xpath('//head/link[@rel="alternate"]').filter_map { |l| [l['hreflang'], strip_origin(l['href'], baseurl)] if l['hreflang'] }.to_h

  unless doc.at_css('.post-language-switch')
    unless (lang_map.keys & %w[en pl x-default]).empty?
      problems << "#{page}: hreflang links without a language switch (non-bilingual page)"
    end
    next
  end

  under_pl = page.start_with?('pl/')
  own = page
  twin = under_pl ? page.delete_prefix('pl/') : "pl/#{page}"
  own_url = "/#{own}"
  twin_url = "/#{twin}"

  # en/x-default always name the English URL and pl the /pl/ one; on a /pl/ page those are own and twin swapped.
  en_url = under_pl ? twin_url : own_url
  pl_url = under_pl ? own_url : twin_url
  missing = %w[en pl x-default] - lang_map.keys
  problems << "#{page}: language switch but no hreflang #{missing.join(', ')}" unless missing.empty?
  problems << "#{page}: hreflang=en must point at #{en_url}" if lang_map['en'] && lang_map['en'] != en_url
  problems << "#{page}: hreflang=pl must point at #{pl_url}" if lang_map['pl'] && lang_map['pl'] != pl_url
  problems << "#{page}: hreflang=x-default must point at the English URL #{en_url}" if lang_map['x-default'] && (lang_map['x-default'] != lang_map['en'] || lang_map['en'] != en_url)

  twin_file = File.join(dir, twin)
  problems << "#{page}: twin #{twin_url} is not a built page" unless File.file?(twin_file)
  if File.file?(twin_file)
    twin_switch_cache[twin] ||= switched?(twin_file)
    problems << "#{page}: twin #{twin_url} has no language switch (broken pair)" unless twin_switch_cache[twin]
  end

  next unless under_pl

  problems << "#{page}: <html lang> must be pl" if doc.at_xpath('/html')&.[]('lang') != 'pl'
  canonical = doc.at_xpath('//head/link[@rel="canonical"]')
  problems << "#{page}: canonical must point at itself" unless canonical && strip_origin(canonical['href'], baseurl) == own_url
end

sitemap = File.read(File.join(dir, 'sitemap.xml'))
Dir.glob("#{dir}/pl/**/*.html").sort.each do |file|
  page = "/#{file.delete_prefix("#{dir}/")}"
  problems << "#{page}: missing from sitemap.xml" unless sitemap.include?(page)
end

feed = File.read(File.join(dir, 'feed.xml'))
problems << 'feed.xml: contains a /pl/ URL (the feed stays English-only)' if feed.include?('/pl/')

if problems.empty?
  puts "OK: bilingual pages consistent (#{Dir.glob("#{dir}/pl/**/*.html").size} /pl/ pages, hreflang pairs, sitemap, feed)"
else
  puts problems.uniq
  abort "#{problems.uniq.size} problem(s) in the bilingual pages"
end
